{
  "manifest_version": 3,
  "name": "AI Seller OS 수집기",
  "version": "0.1.0",
  "description": "알리익스프레스/1688/타오바오 상품 페이지에서 상품명·가격·옵션을 수집해 AI Seller OS로 보냅니다.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Seller OS로 수집"
  }
}
